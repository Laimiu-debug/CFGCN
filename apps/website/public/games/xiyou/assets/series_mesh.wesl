import bevy_pbr::render::{
    mesh_bindings::mesh,
    mesh_functions,
    skinning,
    morph::{morph_position, morph_normal, morph_tangent},
    forward_io::{Vertex, UncompressedVertex, VertexOutput, decompress_vertex},
    view_transformations::position_world_to_clip,
};

@if(MORPH_TARGETS)
/// The instance_index parameter must match vertex_in.instance_index. This is a work around for a wgpu dx12 bug.
/// See https://github.com/gfx-rs/naga/issues/2416
fn morph_vertex(vertex_in: UncompressedVertex, instance_index: u32) -> UncompressedVertex {
    var vertex = vertex_in;
    let first_vertex = mesh[instance_index].first_vertex_index;
    let vertex_index = vertex.index - first_vertex;
    let morph_descriptor_index = mesh[instance_index].morph_descriptor_index;

    let weight_count = bevy_pbr::render::morph::layer_count(morph_descriptor_index);
    for (var i: u32 = 0u; i < weight_count; i ++) {
        let weight = bevy_pbr::render::morph::weight_at(i, morph_descriptor_index);
        if weight == 0.0 {
            continue;
        }
        vertex.position += weight * morph_position(vertex_index, i, morph_descriptor_index);
        @if(VERTEX_NORMALS)
        vertex.normal += weight * morph_normal(vertex_index, i, morph_descriptor_index);
        @if(VERTEX_TANGENTS)
        vertex.tangent += vec4(weight * morph_tangent(vertex_index, i, morph_descriptor_index), 0.0);
    }
    return vertex;
}

// Pack material data into one buffer: WebGL2 guarantees only twelve per stage.
struct PaintUniform {
    tint:vec4<f32>,mist:vec4<f32>,unlit:vec4<f32>,
    vat_meta:vec4<f32>,vat_lower:vec4<f32>,vat_span:vec4<f32>,
};
@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> paint: PaintUniform;
@group(constants::MATERIAL_BIND_GROUP) @binding(5) var vat_texture: texture_2d<f32>;

fn vat_pixel(index:u32)->vec4<f32> {
    let w=u32(paint.vat_meta.w);
    return round(textureLoad(vat_texture,vec2<i32>(i32(index%w),i32(index/w)),0)*255.0);
}
struct VatPose {position:vec3<f32>,normal:vec3<f32>,};
fn vat_pose(index:u32)->VatPose {
    let a=vat_pixel(index);let b=vat_pixel(index+1u);
    let value=vec3<f32>(a.x*256.0+a.y,a.z*256.0+a.w,b.x*256.0+b.y)/65535.0;
    let position=paint.vat_lower.xyz+value*paint.vat_span.xyz;
    let xy=b.zw/255.0*2.0-1.0;
    var n=vec3<f32>(xy,1.0-abs(xy.x)-abs(xy.y));
    if n.z<0.0 { n=vec3<f32>((1.0-abs(n.yx))*select(vec2<f32>(-1.0),vec2<f32>(1.0),n.xy>=vec2<f32>(0.0)),n.z); }
    return VatPose(position,normalize(n));
}
// TERRAIN_PROFILE_START
// Generated by scripts/terrain-profile.mjs from xiyou-terrain.json. Do not edit.
fn t_smooth(a:f32,b:f32,x:f32)->f32 { let t=clamp((x-a)/(b-a),0.0,1.0);return t*t*(3.0-2.0*t); }
fn valley_center(z:f32)->f32{
let result=6.0 * sin(z * 0.07) + 1.6 * sin(z * 0.15);
return result;
}
fn valley_width(z:f32)->f32{
let narrow=t_smooth(27.0, 40.0, z) * (1.0 - t_smooth(50.0, 66.0, z));
let result=mix(21.5, 22.0, t_smooth(58.0, 80.0, z)) - 7.2 * narrow + 0.65 * sin(z * 0.21) + 0.35 * sin(z * 0.43);
return result;
}
fn river_center(x:f32)->f32{
let result=90.0 + 2.8 * sin(x * 0.10) + 0.6 * sin(x * 0.27);
return result;
}
fn river_width(x:f32)->f32{
let result=3.6 + 0.6 * sin(x * 0.16 + 0.4);
return result;
}
fn terrain_height(x:f32,z:f32)->f32{
let bend=0.9 * sin(z * 0.06) + 1.3 * sin(z * 0.025);
let mountain=1.8 + 1.6 * sin(z * 0.045) + 0.6 * cos(z * 0.09);
let valley=0.85 + 0.3 * sin(z * 0.055);
let base=mix(mountain, valley, t_smooth(54.0, 82.0, z));
let roll=(0.7 + 0.5 * sin(x * 0.16 + z * 0.10) + 0.25 * cos(z * 0.22 - x * 0.11)) * t_smooth(2.4, 15.0, abs(x - bend));
let border=valley_width(z);
let shoulder=t_smooth(border - 0.65, border + 1.4, abs(x - valley_center(z))) * (2.85 + 0.5 * sin(z * 0.12 + x * 0.09));
let outer_ridge=t_smooth(border + 1.2, border + 14.0, abs(x - valley_center(z))) * (3.4 + 1.6 * sin(z * 0.09 + x * 0.11));
let ends=(1.0 - t_smooth(-5.4, -2.35, z)) * 6.0 + t_smooth(107.35, 110.4, z) * 6.0;
let land=base + roll + shoulder + ends + outer_ridge;
let distance_to_stream=abs(z - river_center(x));
let bank=t_smooth(river_width(x) - 0.5, river_width(x) + 3.6, distance_to_stream);
let ford=1.0 - t_smooth(2.2, 3.2, abs(x));
let bed=mix(-1.25, -0.10, ford);
let result=mix(bed, land, bank) + (shoulder + ends) * (1.0 - bank);
return result;
}
// TERRAIN_PROFILE_END
@vertex
fn vertex(vertex_no_morph: Vertex) -> VertexOutput {
    var out: VertexOutput;
    let unlit=paint.unlit;
    let vat_meta=paint.vat_meta;
    let uncompressed_vertex_no_morph = decompress_vertex(vertex_no_morph, vertex_no_morph.instance_index);
@if(MORPH_TARGETS)
    var vertex = morph_vertex(uncompressed_vertex_no_morph, vertex_no_morph.instance_index);
@else
    var vertex = uncompressed_vertex_no_morph;

@if(VERTEX_UVS_B && VERTEX_NORMALS) {
    if unlit.y>9.5 && unlit.y<10.5 {
        let tag=mesh_functions::get_tag(vertex_no_morph.instance_index);
        let phase=fract((unlit.z*24.0+f32(tag&65535u)/65535.0*16.0)/16.0)*16.0;
        let moving=(tag&65536u)!=0u && (tag&131072u)==0u;
        var first=select(0u,1u+u32(floor(phase)),moving);
        var second=select(0u,1u+(first%16u),moving);
        var fraction=select(0.0,fract(phase),moving);
        if (tag&524288u)!=0u {
            let attack=f32(tag&65535u)/65535.0*7.0;
            first=17u+u32(floor(attack));second=min(first+1u,u32(vat_meta.z)-1u);fraction=fract(attack);
        }
        let vertex_index=u32(round(vertex.uv_b.x));
        let a=u32(vat_meta.x)+(first*u32(vat_meta.y)+vertex_index)*2u;
        let b=u32(vat_meta.x)+(second*u32(vat_meta.y)+vertex_index)*2u;
        let pose=vat_pose(a);
        vertex.position=pose.position;vertex.normal=pose.normal;
        // Distant walk cycles use 24 Hz poses; roots still move every frame.
        // Close silhouettes and every attack keep interpolation. Idle/frozen
        // vertices never fetch the same frame twice.
        if fraction>0.001 && (unlit.w<0.5 || (tag&524288u)!=0u) {
            let next=vat_pose(b);
            vertex.position=mix(pose.position,next.position,fraction);
            vertex.normal=normalize(mix(pose.normal,next.normal,fraction));
        }
    }
}

    let mesh_world_from_local = mesh_functions::get_world_from_local(vertex_no_morph.instance_index);

@if(SKINNED)
    // Use vertex_no_morph.instance_index instead of vertex.instance_index to work around a wgpu dx12 bug.
    // See https://github.com/gfx-rs/naga/issues/2416 .
    var world_from_local = skinning::skin_model(
        vertex.joint_indices,
        vertex.joint_weights,
        vertex_no_morph.instance_index
    );
@else
    var world_from_local = mesh_world_from_local;

@if(VERTEX_NORMALS && SKINNED)
    out.world_normal = skinning::skin_normals(world_from_local, vertex.normal);
@if(VERTEX_NORMALS && !SKINNED)
    out.world_normal = mesh_functions::mesh_normal_local_to_world(
        vertex.normal,
        // Use vertex_no_morph.instance_index instead of vertex.instance_index to work around a wgpu dx12 bug.
        // See https://github.com/gfx-rs/naga/issues/2416
        vertex_no_morph.instance_index
    );

@if(VERTEX_POSITIONS)
    out.world_position = mesh_functions::mesh_position_local_to_world(world_from_local, vec4<f32>(vertex.position, 1.0));
@if(VERTEX_POSITIONS)
    if unlit.y > 0.5 && unlit.y < 8.5 && unlit.w > 0.5 {
        let floor_height=terrain_height(out.world_position.x, out.world_position.z);
        out.world_position.y += max(floor_height,0.12);
    }
    out.position = position_world_to_clip(out.world_position.xyz);

@if(VERTEX_UVS_A)
    out.uv = vertex.uv;
@if(VERTEX_UVS_B)
    out.uv_b = vertex.uv_b;

@if(VERTEX_TANGENTS)
    out.world_tangent = mesh_functions::mesh_tangent_local_to_world(
        world_from_local,
        vertex.tangent,
        // Use vertex_no_morph.instance_index instead of vertex.instance_index to work around a wgpu dx12 bug.
        // See https://github.com/gfx-rs/naga/issues/2416
        vertex_no_morph.instance_index
    );

@if(VERTEX_COLORS)
    out.color = vertex.color;

@if(VERTEX_OUTPUT_INSTANCE_INDEX)
    // Use vertex_no_morph.instance_index instead of vertex.instance_index to work around a wgpu dx12 bug.
    // See https://github.com/gfx-rs/naga/issues/2416
    out.instance_index = vertex_no_morph.instance_index;

@if(VISIBILITY_RANGE_DITHER)
    out.visibility_range_dither = mesh_functions::get_visibility_range_dither_level(
        vertex_no_morph.instance_index, mesh_world_from_local[3]);

    return out;
}

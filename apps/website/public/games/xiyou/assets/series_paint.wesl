import bevy_pbr::render::forward_io::VertexOutput;
import bevy_pbr::render::mesh_view_bindings::view;
import bevy_pbr::render::mesh_functions::get_tag;

struct PaintUniform {
    tint:vec4<f32>,mist:vec4<f32>,unlit:vec4<f32>,
    vat_meta:vec4<f32>,vat_lower:vec4<f32>,vat_span:vec4<f32>,
};
@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> paint: PaintUniform;
@group(constants::MATERIAL_BIND_GROUP) @binding(1) var painted_texture: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(2) var painted_sampler: sampler;
fn pigment_noise(p:vec2<f32>)->f32 {
    let cell=floor(p);let f=fract(p);let t=f*f*(3.0-2.0*f);
    let a=fract(sin(dot(cell,vec2<f32>(127.1,311.7)))*43758.5453);
    let b=fract(sin(dot(cell+vec2<f32>(1.0,0.0),vec2<f32>(127.1,311.7)))*43758.5453);
    let c=fract(sin(dot(cell+vec2<f32>(0.0,1.0),vec2<f32>(127.1,311.7)))*43758.5453);
    let d=fract(sin(dot(cell+vec2<f32>(1.0),vec2<f32>(127.1,311.7)))*43758.5453);
    return mix(mix(a,b,t.x),mix(c,d,t.x),t.y);
}
fn ink_pair(q:vec2<f32>,a:vec2<f32>,b:vec2<f32>,dx:vec2<f32>,dy:vec2<f32>,offset:vec2<f32>,weight:f32)->vec3<f32>{
    // Two stable world-space phases hide the repeated hand-painted stamp.
    // Explicit gradients stay valid inside per-swatch branches and preserve mipmaps.
    let first=(1.0-abs(fract((q+a)*0.5)*2.0-1.0))*0.48+vec2<f32>(0.01)+offset;
    let second=(1.0-abs(fract((q+b)*0.5)*2.0-1.0))*0.48+vec2<f32>(0.01)+offset;
    return mix(textureSampleGrad(painted_texture,painted_sampler,first,dx*0.48,dy*0.48).rgb,
        textureSampleGrad(painted_texture,painted_sampler,second,dx*0.48,dy*0.48).rgb,weight);
}
// TERRAIN_PROFILE_START
// Generated by scripts/terrain-profile.mjs from xiyou-terrain.json. Do not edit.
fn t_smooth(a:f32,b:f32,x:f32)->f32 { let t=clamp((x-a)/(b-a),0.0,1.0);return t*t*(3.0-2.0*t); }
fn valley_center(z:f32)->f32{
let result=6.0 * sin(z * 0.07) + 1.6 * sin(z * 0.15);
return result;
}
fn valley_width(z:f32)->f32{
let narrow=t_smooth(27.0, 40.0, z) * (1.0 - t_smooth(50.0, 66.0, z));
let result=mix(21.5, 22.0, t_smooth(58.0, 80.0, z)) - 7.2 * narrow + 0.65 * sin(z * 0.21) + 0.35 * sin(z * 0.43);
return result;
}
fn river_center(x:f32)->f32{
let result=90.0 + 2.8 * sin(x * 0.10) + 0.6 * sin(x * 0.27);
return result;
}
fn river_width(x:f32)->f32{
let result=3.6 + 0.6 * sin(x * 0.16 + 0.4);
return result;
}
fn terrain_height(x:f32,z:f32)->f32{
let bend=0.9 * sin(z * 0.06) + 1.3 * sin(z * 0.025);
let mountain=1.8 + 1.6 * sin(z * 0.045) + 0.6 * cos(z * 0.09);
let valley=0.85 + 0.3 * sin(z * 0.055);
let base=mix(mountain, valley, t_smooth(54.0, 82.0, z));
let roll=(0.7 + 0.5 * sin(x * 0.16 + z * 0.10) + 0.25 * cos(z * 0.22 - x * 0.11)) * t_smooth(2.4, 15.0, abs(x - bend));
let border=valley_width(z);
let shoulder=t_smooth(border - 0.65, border + 1.4, abs(x - valley_center(z))) * (2.85 + 0.5 * sin(z * 0.12 + x * 0.09));
let outer_ridge=t_smooth(border + 1.2, border + 14.0, abs(x - valley_center(z))) * (3.4 + 1.6 * sin(z * 0.09 + x * 0.11));
let ends=(1.0 - t_smooth(-5.4, -2.35, z)) * 6.0 + t_smooth(107.35, 110.4, z) * 6.0;
let land=base + roll + shoulder + ends + outer_ridge;
let distance_to_stream=abs(z - river_center(x));
let bank=t_smooth(river_width(x) - 0.5, river_width(x) + 3.6, distance_to_stream);
let ford=1.0 - t_smooth(2.2, 3.2, abs(x));
let bed=mix(-1.25, -0.10, ford);
let result=mix(bed, land, bank) + (shoulder + ends) * (1.0 - bank);
return result;
}
// TERRAIN_PROFILE_END

@fragment
fn fragment(input: VertexOutput) -> @location(0) vec4<f32> {
    let tint=paint.tint;let mist=paint.mist;let unlit=paint.unlit;
    let atlas_ground=(unlit.y>10.5 && unlit.y<11.5)||(unlit.y>15.5 && unlit.y<16.5);
    var color = tint;
    @if(VERTEX_UVS_A) {
        if !atlas_ground {
            color *= textureSample(painted_texture, painted_sampler, input.uv);
        }
    }
    @if(VERTEX_COLORS) {
        @if(VERTEX_UVS_A) {
            if atlas_ground {
                if unlit.y>15.5 {
                    let p=input.world_position.xyz;
                    let phase=pigment_noise(p.xz/52.0)*6.0;
                    let k=floor(phase);
                    let a=fract(vec2<f32>(0.754877666,0.569840296)*k)*13.0;
                    let b=fract(vec2<f32>(0.754877666,0.569840296)*(k+1.0))*13.0;
                    let weight=smoothstep(0.2,0.8,fract(phase));
                    let top=p.xz/19.0;let top_dx=dpdx(top);let top_dy=dpdy(top);
                    let side_x=p.zy/12.0;let side_z=p.xy/12.0;
                    let sx_dx=dpdx(side_x);let sx_dy=dpdy(side_x);
                    let sz_dx=dpdx(side_z);let sz_dy=dpdy(side_z);
                    let grass=ink_pair(top,a,b,top_dx,top_dy,vec2<f32>(0.0),weight);
                    var wash=grass;
                    let crop_axis=p.x*cos(input.uv.y)+p.z*sin(input.uv.y);
                    let crop_cross=-p.x*sin(input.uv.y)+p.z*cos(input.uv.y);
                    let crop_footprint=fwidth(crop_axis);
                    let plant_aa=max(max(crop_footprint/1.35,fwidth(crop_cross)/1.05),0.004);
                    if input.color.r>0.01 {
                        wash=mix(wash,ink_pair(top,a,b,top_dx,top_dy,vec2<f32>(0.5,0.0),weight),input.color.r);
                    }
                    if input.color.b>0.01 {
                        wash=mix(wash,ink_pair(top,a,b,top_dx,top_dy,vec2<f32>(0.5,0.5),weight),input.color.b);
                    }
                    if input.color.g>0.01 {
                        var rock=ink_pair(top,a,b,top_dx,top_dy,vec2<f32>(0.0,0.5),weight);
                        let n=abs(normalize(input.world_normal));
                        if n.y<0.99 {
                            let x=ink_pair(side_x,a,b,sx_dx,sx_dy,vec2<f32>(0.0,0.5),weight);
                            let z=ink_pair(side_z,a,b,sz_dx,sz_dy,vec2<f32>(0.0,0.5),weight);
                            // Steep faces must not retain stretched top-down
                            // stamps. Sharpened triplanar weights use the same
                            // original ink swatch at a stable world scale.
                            let axes=pow(n,vec3<f32>(6.0));
                            let weights=axes/max(axes.x+axes.y+axes.z,0.0001);
                            rock=x*weights.x+rock*weights.y+z*weights.z;
                        }
                        wash=mix(wash,rock,input.color.g);
                    }
                    if input.uv.x>0.01 {
                        if input.uv.y>50.0 {
                            let slab=p.xz/vec2<f32>(1.6,0.95);
                            let stagger=vec2<f32>(slab.x+select(0.0,0.5,i32(floor(slab.y))%2!=0),slab.y);
                            let edge=max(abs(fract(stagger).x-0.5),abs(fract(stagger).y-0.5));
                            let aa=fwidth(edge);
                            let mortar=smoothstep(0.474-aa,0.49+aa,edge);
                            let stone=ink_pair(top,a,b,top_dx,top_dy,vec2<f32>(0.0,0.5),weight);
                            let slab_shade=0.92+0.08*pigment_noise(floor(stagger)*3.1);
                            let paved=mix(mist.rgb*0.86,stone,0.20)*slab_shade*mix(1.0,0.81,mortar);
                            wash=mix(wash,paved,input.uv.x*0.86);
                        } else {
                        // Small leaf sprays, not continuous ruler-like stripes.
                        // They are static terrain brushwork, not extra plant meshes.
                        let plant=vec2<f32>(crop_axis/1.35,crop_cross/1.05);
                        let q=fract(plant)-vec2<f32>(0.5);
                        let stalk=(1.0-smoothstep(0.018,0.035+plant_aa,abs(q.x)))*(1.0-smoothstep(0.18,0.26+plant_aa,abs(q.y)));
                        let left=length(vec2<f32>((q.x+0.1-(q.y+0.02)*0.5)/0.09,(q.y+0.02)/0.18));
                        let right=length(vec2<f32>((q.x-0.1+(q.y-0.035)*0.5)/0.09,(q.y-0.035)/0.18));
                        let leaf=1.0-smoothstep(0.65,1.0+plant_aa*7.0,min(left,right));
                        let crop=max(stalk,leaf*0.88);
                        let strokes=0.65+0.35*pigment_noise(floor(plant)*2.3);
                        let fade=(1.0-smoothstep(28.0,52.0,distance(view.world_position,p)))*(1.0-smoothstep(0.12,0.35,crop_footprint));
                        wash=mix(wash,grass*0.72,input.uv.x*crop*strokes*fade);
                        }
                    }
                    color=vec4<f32>(wash*input.color.a,1.0)*tint;
                } else {
                // Atlas swatches and author-painted masks are identical to
                // the editable Blender material. Grain remains legible;
                // ground colour is not a blurred multiply of two palettes.
                let p=input.world_position.xz;
                let warped=input.uv+vec2<f32>(pigment_noise(p/18.0),pigment_noise(p/23.0+vec2<f32>(7.0)))*select(0.0,0.65,unlit.y>11.1);
                let mirrored=1.0-abs(fract(warped*0.5)*2.0-1.0);
                let swatch=mix(fract(input.uv),mirrored,select(0.0,1.0,unlit.y>11.1));
                let tile=swatch*0.48+vec2<f32>(0.01);
                let dx=dpdx(tile)*select(1.0,1.5,unlit.y>11.1);let dy=dpdy(tile)*select(1.0,1.5,unlit.y>11.1);
                let grass=textureSampleGrad(painted_texture,painted_sampler,tile,dx,dy).rgb;
                let earth=textureSampleGrad(painted_texture,painted_sampler,tile+vec2<f32>(0.5,0.0),dx,dy).rgb;
                let rock=textureSampleGrad(painted_texture,painted_sampler,tile+vec2<f32>(0.0,0.5),dx,dy).rgb;
                let shingle=textureSampleGrad(painted_texture,painted_sampler,tile+vec2<f32>(0.5,0.5),dx,dy).rgb;
                let meadow=mix(grass,earth,input.color.r);
                let bank=mix(meadow,shingle,input.color.b);
                color=vec4<f32>(mix(bank,rock,input.color.g)*input.color.a,1.0)*tint;
                }
            } else {
                color *= input.color;
            }
        } @else {
            color *= input.color;
        }
    }
    if unlit.y > 13.5 && unlit.y < 14.5 {
        // The puppet is an alpha-cutout, not a blended rectangular card.
        // Retain depth writes for the carved silhouette and discard the
        // surrounding atlas space. Exact layer depths survive GLB export.
        if color.a < 0.42 { discard; }
        let fog = smoothstep(38.0, 92.0, distance(view.world_position, input.world_position.xyz));
        return vec4<f32>(mix(color.rgb, mist.rgb, fog), 1.0);
    }
    if unlit.y>14.5 && unlit.y<15.5 {
        // Projected Studio-derived ink paintings share one alpha-cut atlas.
        // Depth writing avoids alpha sorting and full blended-card overdraw.
        if color.a<0.18 { discard; }
        let fog=smoothstep(38.0,92.0,distance(view.world_position,input.world_position.xyz));
        return vec4<f32>(mix(color.rgb,mist.rgb,fog),1.0);
    }
    if unlit.y>15.5 && unlit.y<16.5 {
        // Light ink washes retain their painted values. No plastic PBR
        // highlights or extra full-screen ink/postprocess pass is required.
        let fog=smoothstep(38.0,92.0,distance(view.world_position,input.world_position.xyz));
        return vec4<f32>(mix(color.rgb,mist.rgb,fog),1.0);
    }
    @if(VERTEX_UVS_A && VERTEX_OUTPUT_INSTANCE_INDEX) {
        if unlit.y < -0.5 {
            // Silken 3D strokes use per-instance opacity. Thin lit cores and
            // soft pigment edges replace large, costly layers over the floor.
            let opacity=f32(get_tag(input.instance_index)&65535u)/65535.0;
            let across=abs(input.uv.y*2.0-1.0);
            let edge=pow(max(0.0,1.0-across),select(0.65,0.45,unlit.y < -1.5));
            let ends=smoothstep(0.0,0.06,input.uv.x)*(1.0-smoothstep(0.82,1.0,input.uv.x));
            let core=pow(max(0.0,1.0-across),10.0)*select(0.28,0.75,unlit.y < -1.5);
            let pigment=mix(tint.rgb,color.rgb,color.a*0.82);
            return vec4<f32>(mix(pigment,mist.rgb,core),tint.a*opacity*edge*ends);
        }
    }
    if unlit.y > 8.5 && unlit.y < 9.5 {
        let p=input.world_position.xz;
        let depth=max(0.0,0.12-terrain_height(p.x,p.y));
        let time=unlit.z;
        let ripple=sin(p.y*9.0+p.x*0.4+sin(p.x*0.13+time*0.12)*0.5-time*0.65);
        let line=pow(max(0.0,ripple),32.0);
        let foam=(1.0-smoothstep(0.02,0.35,depth))*(0.35+0.15*ripple);
        let current=mix(tint.rgb*0.68,tint.rgb*1.3,1.0-smoothstep(0.0,1.4,depth));
        let reflected=mix(current,mist.rgb,0.16+max(0.0,ripple)*0.025);
        let water=mix(reflected,mist.rgb,clamp(foam+line*0.035,0.0,0.65));
        let fog=smoothstep(42.0,88.0,distance(view.world_position,input.world_position.xyz));
        return vec4<f32>(mix(water,mist.rgb,fog),0.76+0.1*smoothstep(0.2,1.3,depth));
    }
    // Shared illustrated decals. Progress is instance data, so a paused run
    // freezes exactly and dozens of spells still share four tiny textures.
    @if(VERTEX_UVS_A && VERTEX_OUTPUT_INSTANCE_INDEX) {
        if unlit.y > 0.5 && unlit.y < 8.5 {
            let tag = get_tag(input.instance_index);
            let progress = f32(tag & 65535u) / 65535.0;
            let p = (input.uv - vec2<f32>(0.5)) * 2.0;
            let radius = length(p);
            let aa = max(fwidth(radius), 0.004);
            if unlit.y > 4.5 && unlit.y < 5.5 {
                // Ground contact wash instead of hovering figures.
                return vec4<f32>(tint.rgb, pow(max(0.0, 1.0 - radius), 2.0) * tint.a);
            }
            if unlit.y > 3.5 && unlit.y < 4.5 {
                // The outer contour is EXACTLY the collision radius. The
                // hand-painted wash never stretches beyond that boundary.
                let edge = smoothstep(0.955-aa, 0.973, radius) * (1.0-smoothstep(1.0-aa, 1.0, radius));
                let fill = (1.0-smoothstep(0.97, 1.0, radius)) * (0.08+progress*0.12);
                let clock = smoothstep(progress-0.025,progress,radius) * (1.0-smoothstep(progress,progress+0.025,radius));
                let alpha = max(edge*.92, max(fill, clock*.35));
                return vec4<f32>(mix(tint.rgb, color.rgb, 0.22), alpha*tint.a);
            }
            if unlit.y > 5.5 && unlit.y < 6.5 {
                let angle = atan2(p.y,p.x);
                let cloud = 0.86 + 0.028*sin(angle*6.0) + 0.012*sin(angle*12.0);
                let stroke = (1.0-smoothstep(0.016,0.016+aa,abs(radius-cloud))) * (0.45+0.55*pow(cos(angle*3.0),2.0));
                let tip = exp(-70.0*dot(p-vec2<f32>(0.0,-0.83),p-vec2<f32>(0.0,-0.83)));
                return vec4<f32>(tint.rgb, max(stroke,tip)*tint.a);
            }
            if unlit.y > 6.5 {
                let edge = pow(max(0.0,1.0-abs(p.y)),2.0);
                let ends = smoothstep(0.0,.12,input.uv.x)*(1.0-smoothstep(.88,1.0,input.uv.x));
                return vec4<f32>(tint.rgb, edge*ends*tint.a);
            }
            let fade = (1.0-smoothstep(0.38,1.0,progress));
            return vec4<f32>(color.rgb, color.a*tint.a*fade);
        }
    }
    @if(VERTEX_OUTPUT_INSTANCE_INDEX) {
        if unlit.y>9.5 && unlit.y<10.5 {
            let tag=get_tag(input.instance_index);
            if (tag&131072u)!=0u { color=vec4<f32>(mix(color.rgb,mist.rgb,0.38),color.a); }
            if (tag&262144u)!=0u { color=vec4<f32>(mix(color.rgb,mist.rgb,0.55),color.a); }
        }
    }
    @if(VERTEX_COLORS) {
    if (unlit.y>12.5 && unlit.y<13.5)||(unlit.y>16.5 && unlit.y<17.5) {
        // Streamed-world water uses the same mesh-sampled depth as its banks.
        let p=input.world_position.xz;
        let depth=input.color.r;
        let ink_water=unlit.y>16.5;
        var ripple=pow(max(0.0,sin(p.x*0.7+p.y*1.8-unlit.z*0.7)),28.0);
        if ink_water {
            // Broken, gently bent strokes rather than full-width parallel rules.
            let flow=p.x*0.25+p.y*0.72+sin(p.x*0.13+p.y*0.07)*1.8+sin(p.y*0.23)*0.4;
            let broken=smoothstep(0.28,0.72,sin(p.x*0.24-p.y*0.17+sin(p.y*0.11))*0.5+0.5);
            ripple=pow(max(0.0,sin(flow-unlit.z*0.55)),26.0)*broken*0.65;
        }
        let dilution=select(0.18,mix(0.68,0.38,smoothstep(0.15,1.4,depth)),ink_water);
        let reflected=mix(tint.rgb,mist.rgb,dilution+ripple*0.08);
        let edge=1.0-smoothstep(0.08,0.5,depth);
        let water=mix(reflected,mist.rgb,edge*0.26);
        let fog=smoothstep(38.0,92.0,distance(view.world_position,input.world_position.xyz));
        let bank_pixel=max(fwidth(depth),0.025);
        let coverage=select(1.0,smoothstep(-bank_pixel,0.12+bank_pixel,depth),ink_water);
        return vec4<f32>(mix(water,mist.rgb,fog*select(1.0,0.55,ink_water)),input.color.a*(0.58+0.42*smoothstep(0.1,1.8,depth))*coverage);
    }
    }
    let normal = normalize(input.world_normal);
    let sunlight=max(dot(normal, normalize(vec3<f32>(-0.65, 1.0, -0.45))),0.0);
    let sky=0.40+0.14*max(normal.y,0.0);
    let soft_light=sky+0.56*sunlight;
    let shade=mix(soft_light,1.0,unlit.x);
    let temperature=mix(vec3<f32>(0.85,0.94,1.02),vec3<f32>(1.03,1.0,0.91),sunlight);
    let fog = smoothstep(38.0, 92.0, distance(view.world_position, input.world_position.xyz));
    return vec4<f32>(mix(color.rgb * shade * temperature, mist.rgb, fog), color.a);
}

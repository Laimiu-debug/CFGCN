{
  "name": "cfgcn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cfgcn/website",
    "dev:api": "npm run dev --workspace=@cfgcn/api",
    "build": "npm run build --workspace=@cfgcn/website",
    "preview": "npm run preview --workspace=@cfgcn/website",
    "typecheck": "tsc --noEmit && node --check services/api/src/app.mjs && node --check services/api/src/server.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}

{
  "version": 1,
  "coordinates": "metres, game x and z; Blender x and -y; y is elevation",
  "functions": [
    {
      "name": "valley_center",
      "args": ["z"],
      "steps": [["result", "6.0 * sin(z * 0.07) + 1.6 * sin(z * 0.15)"]]
    },
    {
      "name": "valley_width",
      "args": ["z"],
      "steps": [
        ["narrow", "t_smooth(27.0, 40.0, z) * (1.0 - t_smooth(50.0, 66.0, z))"],
        [
          "result",
          "mix(21.5, 22.0, t_smooth(58.0, 80.0, z)) - 7.2 * narrow + 0.65 * sin(z * 0.21) + 0.35 * sin(z * 0.43)"
        ]
      ]
    },
    {
      "name": "river_center",
      "args": ["x"],
      "steps": [["result", "90.0 + 2.8 * sin(x * 0.10) + 0.6 * sin(x * 0.27)"]]
    },
    {
      "name": "river_width",
      "args": ["x"],
      "steps": [["result", "3.6 + 0.6 * sin(x * 0.16 + 0.4)"]]
    },
    {
      "name": "terrain_height",
      "args": ["x", "z"],
      "steps": [
        ["bend", "0.9 * sin(z * 0.06) + 1.3 * sin(z * 0.025)"],
        ["mountain", "1.8 + 1.6 * sin(z * 0.045) + 0.6 * cos(z * 0.09)"],
        ["valley", "0.85 + 0.3 * sin(z * 0.055)"],
        ["base", "mix(mountain, valley, t_smooth(54.0, 82.0, z))"],
        [
          "roll",
          "(0.7 + 0.5 * sin(x * 0.16 + z * 0.10) + 0.25 * cos(z * 0.22 - x * 0.11)) * t_smooth(2.4, 15.0, abs(x - bend))"
        ],
        ["border", "valley_width(z)"],
        [
          "shoulder",
          "t_smooth(border - 0.65, border + 1.4, abs(x - valley_center(z))) * (2.85 + 0.5 * sin(z * 0.12 + x * 0.09))"
        ],
        [
          "outer_ridge",
          "t_smooth(border + 1.2, border + 14.0, abs(x - valley_center(z))) * (3.4 + 1.6 * sin(z * 0.09 + x * 0.11))"
        ],
        ["ends", "(1.0 - t_smooth(-5.4, -2.35, z)) * 6.0 + t_smooth(107.35, 110.4, z) * 6.0"],
        ["land", "base + roll + shoulder + ends + outer_ridge"],
        ["distance_to_stream", "abs(z - river_center(x))"],
        ["bank", "t_smooth(river_width(x) - 0.5, river_width(x) + 3.6, distance_to_stream)"],
        ["ford", "1.0 - t_smooth(2.2, 3.2, abs(x))"],
        ["bed", "mix(-1.25, -0.10, ford)"],
        ["result", "mix(bed, land, bank) + (shoulder + ends) * (1.0 - bank)"]
      ]
    }
  ]
}
